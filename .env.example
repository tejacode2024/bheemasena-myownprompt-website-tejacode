# ─── Supabase (server-side) ──────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...                # service_role key — keep secret

# ─── Admin auth ──────────────────────────────────────────
ADMIN_SECRET=bheemasena_admin_change_me

# ─── Vite (frontend — embedded at build time) ────────────
# Leave blank for same-origin deployment (Vercel monorepo).
# Set to the deployed admin URL when bheemasena/ runs on a separate Vercel project.
VITE_API_URL=
VITE_ADMIN_SECRET=bheemasena_admin_change_me

# ─── Optional (only if you wire up email OTP later) ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
