# ─── Neon Postgres (server-side) ─────────────────────────
# Get this from neon.tech → Project → Connection Details → "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Admin auth ──────────────────────────────────────────
ADMIN_SECRET=bheema123

# ─── Vite (frontend — embedded at build time) ────────────
# Leave blank for same-origin deployment (Vercel monorepo).
# Set to the deployed admin URL when bheemasena/ runs on a separate Vercel project.
VITE_API_URL=
VITE_ADMIN_SECRET=bheema123

# ─── Optional (only if you wire up email OTP later) ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
